# 範本:複製成 .env.local 再填值。.env.local 不會被上傳(.gitignore 已排除)。
# VITE_BACKEND=mock:模擬通訊層(階段一),不需要任何金鑰。
# VITE_BACKEND=supabase:接真實後端(階段二),需要下面兩個值。
VITE_BACKEND=mock

# 這兩個值本來就會出現在打包後的網頁裡(可以公開),真正的保護是資料庫的 RLS 規則。
# 絕對不要把 Secret key(舊稱 service_role key)、資料庫密碼、Access token 寫進任何檔案。
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
